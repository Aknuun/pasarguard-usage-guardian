[Unit]
Description=PasarGuard Usage Guardian - Telegram settings bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/config-monitor
EnvironmentFile=-/root/config-monitor/.env
ExecStart=/usr/bin/python3 /root/config-monitor/settings_bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
