# ---- Database (optional) ----
# If you configure the panel from the bot (/start -> panel URL + admin user/pass),
# these are NOT needed. Fill them only if you want the direct-DB data source.
PG_DB_HOST=127.0.0.1
PG_DB_PORT=3306
PG_DB_USER=pasarguard
PG_DB_PASSWORD=
PG_DB_NAME=pasarguard

# ---- Telegram ----
# Bot token from @BotFather
PG_BOT_TOKEN=123456:AA...
# Numeric chat id that receives reports / owns the settings bot
PG_CHAT_ID=000000000

# Optional: where state/history files live (defaults to the script directory)
# PG_MONITOR_DIR=/root/config-monitor
